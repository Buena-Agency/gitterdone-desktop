{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gitterdone",
  "version": "1.0.21",
  "identifier": "pro.gitterdone.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "capabilities": ["main-bridge", "pill-bridge"],
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "public.app-category.productivity",
    "shortDescription": "Gitterdone",
    "longDescription": "Desktop shell for Gitterdone — always loads the latest deployed web app.",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Buena-Agency/gitterdone-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlDOUEyQkZEN0JEODlDOEMKUldTTW5OaDcvU3VhbkVobzA5aFIyM1gvMERNTmppZGx2OFJpVWVaOG5tZEt6dGJSalZxbjlTclAK"
    }
  }
}
